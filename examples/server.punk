http:import!punk.http.
html:import!punk.html.
keystore:import!punk.keystore.

db:keystore.open!todo\.kv

initialKeys:keystore.keys!db?
initialKeys.#?->[nextId]!

id:(x:_){x?}

listTodos:(_:_){
  keys:keystore.keys!db?
  map!{(k:_){
    raw:keystore.get!{db? k?}
    name!{k? raw?}
  } keys?}
}

createTodo:(note:_ desc:_){
  cur:[nextId]->id!
  key:concat!{t cur?}
  val:concat!{note? \  desc?}
  keystore.put!{db? key? val?}
  next:+!{cur? 1}
  next?->[nextId]!
}

renderTodoItem:(v:_ i:_ k:_){
  li:(){concat!{k? \:\  v?}}
  name!{li li?}
}

indexPage:(todos:___){
  (lang:en){
    head:(){
      title:(){punk-todo}
    }
    body:(){
      h1:(){Todo}
      form:(method:POST action:/todo enctype:text/plain){
        input:(name:note type:text){}
        input:(name:description type:text){}
        button:(type:submit){Add\ Item}
      }
      ul:(){
        map!{renderTodoItem? todos?}
      }
    }
  }
}

doctype:concat!{\<\!DOCTYPE\  html\>}

index:(_:___){
  todos:listTodos!NULL
  body:concat!{doctype? html.render!indexPage!todos?}
  {status:200 headers:{Content-Type:text/html} body:body?}
}

createTodoHandler:(method:_ path:_ body:_){
  form:html.parsePost!body?
  createTodo!{form.note? form.description?}
  {status:303 headers:{Location:/} body:\ }
}

notFound:(_:___){
  {status:404 headers:{Content-Type:text/plain} body:Not\ Found}
}

routeKey:(req:___){concat!{req.1? \  req.2?}}

dispatch:(req:___){
  key:routeKey!req?
  key??{
    (GET\ /){index!req?}
    (POST\ /todo){createTodoHandler!{req.1? req.2? req.3?}}
    (___){notFound!req?}
  }
}

http.serve!{8080 dispatch?}
log!listening\ on\ port\ 8080
