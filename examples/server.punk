# Import reusable Punk modules. #
html:import!punk.html
keystore:import!punk.keystore

# Open append-only todo store and keep the current handle in atom @db. #
keystore.open!todo->@db!

# Add a todo: append new {key value} entry and write the returned handle back to @db. #
createTodo:([note] [desc]){
  @db->keystore.put'{
    keystore.newKey!
    {note:note? desc:desc?}
  }->@db!
}~

# Pull replayed entries from a keystore handle. #
dbEntries:([h]){
  h.entries?
}~

# Extract one field from parsed form pairs: {{note "x"} {description "y"}}. #
formValue:([key] [pairs]){
  reduce!{
    ([acc] [pair]){
      =!{pair.1? key?}??{
        (TRUE){pair.2?}
        (FALSE){acc?}
      }!
    }~
    NULL
    pairs?
  }
}~

# Page template as DATA (functions as data):
# - `indexPage` returns an element-tree value (html/head/body/etc).
# - Nothing renders here; this is just structured data.
# - `html.render!` later consumes this function-produced data and turns it into text/HTML. #
indexPage:(){
  <\!DOCTYPE html>
  html:(lang:en){
    head:{
      title:{punk-todo}
    }
    body:{
      h1:{Todo}
      form:(method:POST action:\/todo enctype:text\/plain){
        input:(name:note type:text){}
        input:(name:description type:text){}
        button:(type:submit){Add Item}
      }
      ul:{}
    }
  }
}~

# GET / -> render the page data into HTML text and return HTTP response. #
index:([req]){
  body:html.render!indexPage!
  {status:200 headers:{Content-Type:text\/html} body:body?}
}~

# POST /todo -> parse plain-text form body, persist new todo, redirect to /. #
createTodoHandler:([req]){
  form:html.parsePost!req.3?
  createTodo!{formValue!{note form?} formValue!{description form?}}
  {status:303 headers:{Location:\/} body:{}}
}~

# Fallback route response. #
notFound:([req]){
  {status:404 headers:{Content-Type:text\/plain} body:{Not Found}}
}~

# Route dispatcher for request shape {method url body}. #
dispatch:([req]){
  isGetRoot:and!{=!{req.1? GET} =!{req.2? "/"}}
  isPostTodo:and!{=!{req.1? POST} =!{req.2? "/todo"}}
  isGetRoot??{
    (TRUE){index!req?}
    (FALSE){
      isPostTodo??{
        (TRUE){createTodoHandler!req?}
        (FALSE){notFound!req?}
      }!
    }
  }!
}~

# Start server by passing callable dispatch reference to core httpServe!. #
httpServe!{8080 dispatch.!?}
print!{listening on port 8080}
