## A tiny todo web app. Run it with: npm start examples/server.punk
## then open http://localhost:8080
##
## HTML is code as data: elements are named functions that are never
## called. punk.html reads their pattern (attributes) and body (children).

http:import!punk.http
html:import!punk.html

## state lives in an atom: the list of todo notes
[] > @todos!

page:(#)[
  html.page![
    head:()[
      title:()[Todos]
    ]
    body:()[
      h1:()[Todos]
      ul:()[@todos > map!(note:_)[
        li:()[{note?}]
      ]]
      form:(method:POST action:/add)[
        input:(name:note)[]
        button:()[Add]
      ]
    ]
  ]
]

## the request is [method:.. url:.. headers:[..] body:..]; serve parses a
## form body so it can be queried as body.note?
route:(method:_ url:_ headers:_ body:_)[
  [method? url?]
  -> (GET /)[page! > http.ok!]
  -> (POST /add)[
    body.note? > push![@todos] > @todos!
    http.redirect!/
  ]
  -> (_ _)[http.notFound![Not found]]
]

serve![8080 route?]
print![Listening on port 8080]
