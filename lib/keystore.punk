#keystore.punk — append-only key/value store.

  A "handle" is a tmpl {path entries} that represents a snapshot of the
  store. `open!` builds one from disk. `put!` appends to disk AND returns
  a new handle reflecting the added entry — callers pipe it back into
  whatever box holds the current handle.#

encode:(key:_ value:_){serialize!{key? value?}}

decode:(line:_){deserialize!line?}

nonempty:(l:_){>!{l.#? 0}}

fileLines:(p:_){
  has:exists!p?
  has??{
    (TRUE){read!p?}
    (FALSE){{}}
  }
}

readEntries:(path:_){
  map!{decode? filter!{nonempty? fileLines!path?}}
}

handle:(path:_ entries:_){
  {path:path? entries:entries?}
}

open:(name:_){
  path:concat!{name? \.keystore}
  handle!{path? readEntries!path?}
}

put:(key:_ value:_ h:_){
  append!{h.path? encode!{key? value?}}
  handle!{h.path? concat!{h.entries? {{key? value?}}}}
}

get:(key:_ h:_){
  reduce!{
    (acc:_ pair:_){
      hit:=!{pair.1? key?}
      hit??{(TRUE){pair.2?} (FALSE){acc?}}
    }
    NULL
    h.entries?
  }
}

keys:(h:_){
  map!{(pair:_){pair.1?} h.entries?}
}

list:(h:_){
  map!{(pair:_){name!{pair.1? pair.2?}} h.entries?}
}

nextKey:(prefix:_ h:_){
  concat!{prefix? h.entries.#?}
}

newKey:(){uuid!}

{
  open:open?
  put:put?
  get:get?
  keys:keys?
  list:list?
  nextKey:nextKey?
  newKey:newKey?
}
