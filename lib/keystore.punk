#keystore.punk -- append-only key/value store in pure Punk.

 Datomic-flavoured: the on-disk file IS the immutable transaction
 log. Each `put!` appends one line AND returns a NEW handle, so
 older handles keep their pre-put view of the world and callers
 compose snapshots functionally.

 Usage:
   keystore:import!punk.keystore.
   db:[keystore.open!./todo\.kv]                  -- hold in a cell
   db<-keystore.put!(db-> note buy+milk)          -- reassign cell
   keystore.get!(db-> note)                       -- buy+milk
   snap:db->                                      -- pin a snapshot
   db<-keystore.put!(db-> note buy+bread)
   keystore.get!(db->  note)                      -- buy+bread (current)
   keystore.get!(snap. note)                      -- buy+milk  (snapshot)

 The caller controls evaluation: leave args bare to pass them as
 symbols, or add `!` (e.g. `key!`) to splice an already-bound
 value. A handle is internally `(path entries)` where entries is
 a list of `(key value)` pairs, latest at the front.#

#encode emits a punk-native `name:value` line; decode calls
 `deserialize!` on a line and returns the resulting NamedThing as
 a `(key value)` pair — no special parsing.#
encode:{name:_ value:_}(join!(list!(name. value.) \:))

decode:{line:_}(
  nt:deserialize!line.
  list!(nt.name. nt.value.)
)

nonempty:{l:_}(=!(len!l. 0)?({TRUE}(FALSE) {FALSE}(TRUE)))

#---- Open ----#

open:{path:_}(
  lines:exists!path.?(
    {TRUE}(read!path.)
    {FALSE}(())
  )
  list!(path. map!(decode filter!(nonempty lines.)))
)

#---- Put ----#
#Append one entry to disk AND return a new handle whose entries
 has the new pair appended (oldest-first ordering). The OLD handle
 is unchanged.#

put:{db:_ key:_ value:_}(
  entry:list!(key. value.)
  append!(db.0. encode!entry.)
  list!(db.0. concat!(db.1. list!(entry.)))
)

#---- Get ----#
#Walk entries and return value of the LAST match for key, or NULL
 if absent. Entries are stored oldest-first, so the last match is
 the most recent write.#

get:{db:_ key:_}(
  reduce!({acc:_ pair:_}(
    =!(pair.0. key.)?(
      {TRUE}(pair.1.)
      {FALSE}(acc.)
    )
  ) NULL db.1.)
)

#---- Keys ----#
#Unique keys currently visible (latest-first order).#

keys:{path:_ entries:_}(
  reduce!({acc:_ pair:_}(
    contains!(acc. pair.0.)?(
      {TRUE}(acc.)
      {FALSE}(prep!(pair.0. acc.))
    )
  ) () entries.)
)
