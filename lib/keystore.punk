#keystore.punk — append-only key/value store.
  Handle shape: {path entries}
  - `path` is the log file path.
  - `entries` is the in-memory replay of `{key value}` lines.
  Writes append to disk and return a fresh immutable handle.#

encode:([key] [value]){serialize!{key? value?}}~
decode:([line]){deserialize!line?}~
nonempty:([l]){>!{l.#? 0}}~

fileLines:([p]){
  exists!p??{
    (TRUE){read!p?}
    (FALSE){{}}
  }!
}~

readEntries:([p]){
  lines:fileLines!p?
  nonblank:filter!{nonempty.!? lines.1?}
  map!{decode.!? nonblank?}
}~

handle:([path] [entries]){
  {path:path? entries:entries?}
}~

open:([name]){
  path:join!{"" {name? \.keystore}}
  handle!{path? readEntries!path?}
}~

put:([key] [value] [h]){
  line:encode!{key? value?}
  append!{h.path? join!{"" {line? \n}}}
  handle!{h.path? readEntries!h.path?}
}~

get:([key] [h]){
  reduce!{
    ([acc] [pair]){
      =!{pair.1? key?}??{
        (TRUE){pair.2?.?}
        (FALSE){acc?}
      }!
    }~
    NULL
    h.entries?
  }
}~

keys:([h]){
  map!{([pair]){pair.1?}~ h.entries?}
}~

list:([h]){
  h.entries?
}~

nextKey:([prefix] [h]){
  join!{"" {prefix? h.entries.#?}}
}~

toCuidChar:([n]){
  n??{
    (1){a}   (2){b}   (3){c}   (4){d}   (5){e}   (6){f}
    (7){g}   (8){h}   (9){i}   (10){j}  (11){k}  (12){l}
    (13){m}  (14){n}  (15){o}  (16){p}  (17){q}  (18){r}
    (19){s}  (20){t}  (21){u}  (22){v}  (23){w}  (24){x}
    (25){y}  (26){z}  (27){0}  (28){1}  (29){2}  (30){3}
    (31){4}  (32){5}  (33){6}  (34){7}  (35){8}  (36){9}
  }!
}~

randomCuidChar:(){
  toCuidChar!+!{1 floor!{X!{rand! 36}}}
}~

cuid2:(){
  tail:join!{"" map!{([x]){randomCuidChar!}~ 1~23}}
  join!{"" {c tail?}}
}~

newKey:(){cuid2!}~

module:(){
  {
    open:open.!?
    put:put.!?
    get:get.!?
    keys:keys.!?
    list:list.!?
    nextKey:nextKey.!?
    newKey:newKey.!?
  }
}~

module!
