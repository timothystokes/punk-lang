#keystore.punk — append-only key/value store.

  The on-disk file IS the source of truth. A "handle" is just the path —
  put!/get!/keys! re-read on each call. Simple, no in-memory state.#

encode:(key:_ value:_){serialize!{key? value?}}

decode:(line:_){deserialize!line?}

nonempty:(l:_){>!{l.#? 0}}

fileLines:(p:_){
  has:exists!p?
  has??{
    (TRUE){read!p?}
    (FALSE){{}}
  }
}

entries:(path:_){
  map!{decode? filter!{nonempty? fileLines!path?}}
}

open:(path:_){path?}

put:(path:_ key:_ value:_){
  append!{path? encode!{key? value?}}
  path?
}

get:(path:_ key:_){
  reduce!{
    (acc:_ pair:_){
      hit:=!{pair.1? key?}
      hit??{(TRUE){pair.2?} (FALSE){acc?}}
    }
    NULL
    entries!path?
  }
}

keys:(path:_){
  map!{(pair:_ i:_){pair.1?} entries!path?}
}

{
  open:open?
  put:put?
  get:get?
  keys:keys?
}
