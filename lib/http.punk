node:importJS!http

makeRequest:(req:_ body:_){
  {req.method? req.url? body?}
}

respond:(res:_ result:_){
  res.writeHead!{result.status? result.headers?}
  res.end!result.body?
}

methodNeedsBody:(m:_){
  m??{
    (POST){TRUE}
    (PUT){TRUE}
    (PATCH){TRUE}
    (___){FALSE}
  }
}

adapt:(handler:_){
  (req:_ res:_){
    needs:methodNeedsBody!req.method?
    needs??{
      (TRUE){streamRead!{req? (body:_){
        respond!{res? handler!makeRequest!{req? body?}}
      }}}
      (FALSE){respond!{res? handler!makeRequest!{req? NULL}}}
    }
  }
}

serve:(port:_ handler:_){
  srv:node.createServer!adapt!handler?
  srv.listen!port?
  srv?
}

{serve:serve?}
