voidTags:{area base br col embed hr img input link meta source track wbr}

escText:([s]){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{> &gt; s2?}
  s3?
}~

escAttr:([s]){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{\" &quot; s2?}
  s3?
}~

isVoid:([tag]){contains!{tag? voidTags?}}

renderAttrs:([info]){
  slots:info.ordered?
  parts:map!{([slot]){
    k:slot.bind?
    k??{
      (NULL){""}
      (_){
        or!{=!{slot.match? _} =!{slot.match? *}}??{
          (TRUE){""}
          (FALSE){"{k?}=\"{escAttr!{slot.match?}}\""}
        }!
      }
    }!
  }~ slots?}
  keep:filter!{([p]){not!isempty!p?}~ parts?}
  join!{" " keep?}
}~

renderLeaf:([value]){
  islist!value??{
    (TRUE){join!{" " render!value.?}}
    (FALSE){escText!{value?}}
  }!
}~

renderNamedTmpl:([tag] [body]){
  inner:join!{" " render!body.?}
  isVoid!tag??{
    (TRUE){"<{tag?}/>"}
    (FALSE){"<{tag?}>{inner?}</{tag?}>"}
  }!
}~

renderNamedFn:([tag] [attrs] [body]){
  inner:join!{" " render!body.?}
  isVoid!tag??{
    (TRUE){
      isempty!attrs??{
        (TRUE){"<{tag?}/>"}
        (FALSE){"<{tag?} {attrs?}/>"}
      }!
    }
    (FALSE){
      isempty!attrs??{
        (TRUE){"<{tag?}>{inner?}</{tag?}>"}
        (FALSE){"<{tag?} {attrs?}>{inner?}</{tag?}>"}
      }!
    }
  }!
}~

render:(*[items]){
  map!{(*[wrap]){
    tag:wrap.1.:?
    isFn:isfn!wrap.1.!?
    patInfo:wrap.1._?
    isFn??{
      (FALSE){
        tag??{
          (NULL){renderLeaf!{wrap.1?}}
          (_){
            patInfo??{
              (NULL){renderNamedTmpl!{tag? wrap.1?}}
              (*){renderNamedFn!{tag? renderAttrs!patInfo? {}}}
            }!
          }
        }!
      }
      (TRUE){
        renderNamedFn!{tag? renderAttrs!wrap.1._? wrap.1?}
      }
    }!
  }~ items?}
}~

parseLine:([line]){
  parts:split!{\= line?}
  parts.#??{
    (1){name!{parts.1? {}}}
    (___){name!{parts.1? parts.2?}}
  }!
}~

parsePost:([body]){
  lines:split!{\n body?}
  map!{([line]){parseLine!line?}~ lines?}
}~

{render:render? escText:escText? escAttr:escAttr? parsePost:parsePost?}
