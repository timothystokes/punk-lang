voidTags:{area base br col embed hr img input link meta source track wbr}

escText:(s:_){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{> &gt; s2?}
  s3?
}

escAttr:(s:_){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{\" &quot; s2?}
  s3?
}

isVoid:(tag:_){contains!{tag? voidTags?}}

renderAttrs:(fn:_){
  attrs:pattern!fn?
  parts:map!{(v:_ i:_ k:_){
    concat!{\  k? \=\" escAttr!text!v? \"}
  } attrs?}
  concat!parts?
}

walk:(tag:_ fn:_){
  attrs:renderAttrs!fn?
  void:isVoid!tag?
  void??{
    (TRUE){concat!{\< tag? attrs? \/\>}}
    (FALSE){
      kids:template!fn?
      parts:map!{(v:_ i:_ k:_){
        islist:islist!v?
        islist??{
          (TRUE){
            inner:map!{(vv:_ ii:_ kk:_){
              isfn:isfn!vv?
              isfn??{
                (TRUE){walk!{kk? vv?}}
                (FALSE){escText!text!vv?}
              }
            } v?}
            concat!inner?
          }
          (FALSE){
            isfn:isfn!v?
            isfn??{
              (TRUE){walk!{k? v?}}
              (FALSE){escText!text!v?}
            }
          }
        }
      } kids?}
      inner:concat!parts?
      concat!{\< tag? attrs? \> inner? \<\/ tag? \>}
    }
  }
}

render:(page:_){
  walk!{html page?}
}

parseLine:(line:_){
  parts:split!{\= line?}
  parts.#??{
    (1){name!{parts.1? \ }}
    (___){name!{parts.1? parts.2?}}
  }
}

parsePost:(body:_){
  lines:split!{\n body?}
  map!{(line:_){parseLine!line?} lines?}
}

{render:render? escText:escText? escAttr:escAttr? parsePost:parsePost?}
