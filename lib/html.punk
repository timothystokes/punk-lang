voidTags:{area base br col embed hr img input link meta source track wbr}

escText:([s]){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{> &gt; s2?}
  s3?
}~

escAttr:([s]){
  s1:replace!{& &amp; s?}
  s2:replace!{< &lt; s1?}
  s3:replace!{\" &quot; s2?}
  s3?
}~

isVoid:([tag]){contains!{tag? voidTags?}}

renderAttrs:([info]){
  slots:info.ordered?
  parts:map!{([slot]){
    k:slot.bind?
    k??{
      (NULL){""}
      (_){
        or!{=!{slot.match? _} =!{slot.match? *}}??{
          (TRUE){""}
          (FALSE){"{k?}=\"{escAttr!{slot.match?}}\""}
        }!
      }
    }!
  }~ slots?}
  keep:filter!{([p]){not!isempty!p?}~ parts?}
  join!{" " keep?}
}~

renderLeaf:([value]){
  islist!value??{
    (TRUE){join!{" " render!value.?}}
    (FALSE){escText!{value?}}
  }!
}~

renderNamedTmpl:([tag] [body]){
  inner:join!{" " render!body.?}
  isVoid!tag??{
    (TRUE){"<{tag?}/>"}
    (FALSE){"<{tag?}>{inner?}</{tag?}>"}
  }!
}~

renderNamedFn:([tag] [attrs] [body]){
  inner:join!{" " render!body.?}
  isVoid!tag??{
    (TRUE){
      isempty!attrs??{
        (TRUE){"<{tag?}/>"}
        (FALSE){"<{tag?} {attrs?}/>"}
      }!
    }
    (FALSE){
      isempty!attrs??{
        (TRUE){"<{tag?}>{inner?}</{tag?}>"}
        (FALSE){"<{tag?} {attrs?}>{inner?}</{tag?}>"}
      }!
    }
  }!
}~

render:(*[items]){
  # `render` is variadic: `items` is the already-decomposed set of
  sibling elements to render — NOT one structured content-tree. A
  caller holding one content value (e.g. body? or page?, itself
  {}-shaped, one thing) must decompose it into that sibling set
  explicitly via .? before calling — see render!body.? below
  and renderPage's own call. #
  map!{(*[wrap]){
    tag:wrap.1.:?
    isFn:isfn!wrap.1.!?
    patInfo:wrap.1._?
    isFn??{
      (FALSE){
        tag??{
          (NULL){renderLeaf!{wrap.1?}}
          (_){
            patInfo??{
              (NULL){renderNamedTmpl!{tag? wrap.1?}}
              (*){renderNamedFn!{tag? renderAttrs!patInfo? {}}}
            }!
          }
        }!
      }
      (TRUE){
        renderNamedFn!{tag? renderAttrs!wrap.1._? wrap.1?}
      }
    }!
  }~ items?}
}~

renderPage:(*[items]){
  # Same contract as render: items must already be the decomposed
  sibling elements of the page content, hence the .? when calling
  render below and when callers pass a single content value in
  (e.g. html.renderPage!{indexPage!.?}). #
  body:join!{" " render!items.?}
  "<!DOCTYPE html>\n{body?}"
}~

# split! already returns each piece as a proper Tmpl-wrapped Text
value, so parts.1?/parts.2? are ready to drop straight into the pair
below with no extra coercion. #
parseLine:([line]){
  parts:split!{\= line?}
  parts.#??{
    (1){{parts.1? {}}}
    (_){{parts.1? parts.2?}}
  }!
}~

# Raw `key=value` lines as a list of pairs: {{note "x"} {description "y"}}. #
parsePost:([body]){
  lines:split!{\n body?}
  map!{([line]){parseLine!line?}~ lines?}
}~

# Same `text/plain` form body, as a proper record: {note:"x" description:"y"}.
`toRecord!` is a core builtin — Punk source has no way to construct a
Named entry with a runtime-computed key, so building a record out of
parsed field pairs needs that escape hatch. #
parseForm:([body]){
  toRecord!parsePost!body?
}~

module:(){
  {
    render:render.!?
    renderPage:renderPage.!?
    escText:escText.!?
    escAttr:escAttr.!?
    parsePost:parsePost.!?
    parseForm:parseForm.!?
  }
}

module!
