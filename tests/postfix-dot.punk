#Postfix-dot dereference: every chain step ends with `.`, `!`, `<-` or `->`#

#`name.` reads the value bound to `name`#
greeting:hello
assert!(greeting. hello)

#`name` alone is data; `name.` is the value#
literal:hello
assert!(literal literal)
assert!(literal. hello)

#Implicit dereference before `!` — `fn!arg` works without a separate `.`#
shout:{s:_}(upper!s.)
assert!(shout!hello HELLO)

#Implicit dereference before `->` and `<-` for cells#
box:[0]
box<-7
assert!(box-> 7)

#Chain through namespaces — `+!` is two steps, last terminated by `!`#
assert!(+!(1 2) 3)

#Index literals: every step needs its `.`#
assert!((10 20 30).0. 10)
assert!((10 20 30).~. 30)

#Mixed: name -> index -> name -> last#
data:((name:Alice age:30) (name:Bob age:40))
assert!(data.0.name. Alice)
assert!(data.~.age. 40)

#Slice sugar: `N~` open end, `~N` open start, `N~M` both bounds {ends inclusive}#
xs:(10 20 30 40 50)
assert!(xs.0~. (10 20 30 40 50))
assert!(xs.2~. (30 40 50))
assert!(xs.1~3. (20 30 40))
assert!(xs.~2. (10 20 30))
#out-of-range slices yield ()#
assert!(xs.9~. ())
assert!(().0~. ())
#slice result chains like any list#
assert!(xs.1~3.0. 20)

#Polymorphic drill-down: text and numbers index like lists of chars/digits#
word:Steve
assert!(word.0. S)
assert!(word.3. v)
assert!(word.~. e)
assert!(word.0~2. Ste)
assert!(word.~2. Ste)
n:12345
assert!(len!n. 5)
assert!(n.1~3. 234)
#decimals: comma is the separator under indexing/slicing too#
pi:3,14
assert!(pi.1. ,)
assert!(pi.0~1. 3,)
assert!(pi.2~3. 14)
#chain: list -> text -> char#
names:(Tim Bob)
assert!(names.0.0. T)
assert!(names.~.~. b)
