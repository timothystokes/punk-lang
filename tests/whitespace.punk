#Whitespace tolerance.
 Rule: brackets ( ) { } [ ] are themselves zero-width delimiters.
 Between things, any run of whitespace {spaces, tabs, newlines} is the
 single separator. So `(1 2 3)` and `( 1\n2\n3 )` are identical.#

#1. Inside any (...) whitespace {including newlines} is free.#
assert!(
    (1 2 3)
    (1
     2
     3)
  )

#A list-as-args is just `(...)` after `!`; inner whitespace is free.#
assert!(len!(   1   2   3   ) 3)
assert!(len!(1
              2
              3) 3)

#2. Function literal body can span lines.#
sum:{a:_ b:_}(
  +!(a. b.)
)
assert!(sum!(2 3) 5)

#3. Pattern braces tolerate inner whitespace.#
swap:{ a:_   b:_ }(
  prep!(b. prep!(a. ()))
)
assert!(swap!(1 2) (2 1))

#3b. Function literal: inner whitespace OK on both sides, but `}(` must be tight.#
loose:{ n:_ }( n. )
assert!(loose!7 7)
inline:5?{ 5 }(yes)
assert!(inline. yes)

#4. Bindings: `:` must be tight on both sides.#
greeting:hello
assert!(greeting. hello)

#5. Multiline conditionals.#
x:5
y:x.?(
  {5}(found-five)
  {_}(other)
)
assert!(y. found-five)

#6. The IDE-friendly multi-line function from the docs round-trips.#
startsWith:{s:_ p:_}(
    =!(slice!(s. 0 len!p.) p.)
  )
assert!(startsWith!(hello he) TRUE)
assert!(startsWith!(hello hi) FALSE)

#7. Brackets act as zero-width delimiters: `(a)(b)` is two things.#
assert!(((1 2)(3 4)) ((1 2) (3 4)))

#---- Forbidden whitespace {documented, not assertable here} ----#
#  log! hello   {space after ! ends the call with no arg}#
#  log !hello   {! cannot start a primary token}#
#  1 ~ 5        {Range literals must be tight}#
#  xs .0.       {postfix . must hug its preceding primary}#
#  name : v     {bindings : must be tight on both sides}#
#  {p} (body)   {function literal must be tight between '}' and '('}#

