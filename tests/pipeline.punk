#Pipeline `|`: `a | f.` desugars to `f!a` (LHS wrapped as a single arg).
 The RHS is a function *value* (terminated by `.`), same rule as `map![xs f.]`.#

#Single stage#
assert![[a b c] | head. a]
assert![[a b c] | tail. [b c]]

#Multi-stage pipeline (left-associative): a | f. | g. == g!f!a#
assert![hello | split. | head. h]
assert![hello | split. | len. 5]

#Whitespace around `|` is irrelevant#
assert![[1 2 3]|len. 3]
assert![[1 2 3]   |   head. 1]

#Pipeline accepts dotted callees and derefs#
chars:hello | split.
#The result is bound the usual way#
assert![chars. | len. 5]

#A list-valued LHS isn't spread across positional slots#
assert![[x y z] | tail. [y z]]

#Any expression that evaluates to a function value works as a stage.
 Here `getFn!head` calls a function which returns the head fn itself,
 which is then applied to the LHS by the pipe.#
getFn:(name:_)[name. ?? [[head head.] [tail tail.] [len len.]]]
assert![[a b c] | getFn!head a]
