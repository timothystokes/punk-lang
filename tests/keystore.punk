#keystore.punk — append-only datomic-flavoured kv store. Handles
 are immutable snapshots. To use mutably, hold the handle in a
 cell and reassign on each put!. Old handles taken before the
 reassign still return their original view.#

keystore:import!punk.keystore.

path:/tmp/punk\-keystore\-test\.log
write!(path. ())

#cell holds the "current" handle; put! returns a new handle which
 we write back into the cell#
db:[keystore.open!path.]

#snapshot of the empty state — bound to a name, not a cell, so it
 stays pinned to the original handle no matter what db does later#
empty:db->

db<-keystore.put!(db-> note buy+milk)
afterMilk:db->

db<-keystore.put!(db-> color blue)
db<-keystore.put!(db-> note buy+bread)

#current cell content sees the latest writes#
assert!(keystore.get!(db-> note) buy+bread)
assert!(keystore.get!(db-> color) blue)
assert!(len!keystore.keys!db->. 2)

#old snapshot still sees nothing — handle was captured before any put#
assert!(keystore.get!(empty. note) NULL)
assert!(keystore.get!(empty. color) NULL)
assert!(len!keystore.keys!empty. 0)

#intermediate snapshot sees only the first put#
assert!(keystore.get!(afterMilk. note) buy+milk)
assert!(keystore.get!(afterMilk. color) NULL)
assert!(len!keystore.keys!afterMilk. 1)

#reload from disk also recovers the latest state#
db<-keystore.open!path.
assert!(keystore.get!(db-> note) buy+bread)
assert!(keystore.get!(db-> color) blue)
assert!(keystore.get!(db-> missing) NULL)
assert!(len!keystore.keys!db->. 2)

write!(path. ())
