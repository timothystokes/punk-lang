#Mutable cells with `{value}`, read `>`, write `<`#

#Create a cell#
counter:{0}
assert![counter> 0]

#Write a new value#
counter<5
assert![counter> 5]

#Update by read-modify-write#
counter<math.add![counter> 1]
assert![counter> 6]

#Cells can hold any Thing, including lists#
buffer:{[]}
buffer<list.concat![buffer> [hello]]
buffer<list.concat![buffer> [world]]
assert![buffer> [hello world]]
