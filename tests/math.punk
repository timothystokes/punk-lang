#math namespace — every assertion is a self-check#

#Binary arithmetic#
assert!(+!(5 3) 8)
assert!(-!(10 4) 6)
assert!(*!(6 7) 42)
assert!(/!(20 4) 5)
assert!(%!(10 3) 1)
assert!(^!(2 8) 256)

#Symbol aliases — `+ - * / ^ %` are callable Things bound to the same builtins#
assert!(+!(5 3) 8)
assert!(-!(10 4) 6)
assert!(*!(6 7) 42)
assert!(/!(20 4) 5)
assert!(^!(2 8) 256)
assert!(%!(10 3) 1)
assert!(=!(2 2) TRUE)
assert!(=!(2 3) FALSE)

#Embedded in text the symbols are ordinary characters — `1+2` is the Thing
 "1+2" {three characters}, not a parse error and not the number 3.#
assert!(len!split!1+2 3)
assert!(=!(1+2 3) FALSE)
assert!(len!split!1/2 3)

#Variadic min / max — accept any number of Things#
assert!(min!(3 1 4 1 5 9 2 6) 1)
assert!(max!(3 1 4 1 5 9 2 6) 9)

#Type predicate#
assert!(isnum!42 TRUE)
assert!(isnum!hello FALSE)

#Pattern-shaped error message for wrong arity {demo, commented}#
#+!5#
