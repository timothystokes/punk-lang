#List builtins are polymorphic: text and numbers auto-decompose, the
 result is rewrapped to the same shape. No explicit split!/join! needed.#

#slice! on text and numbers#
assert!(slice!(hello 0~1) he)
assert!(slice!(hello 1~) ello)
assert!(slice!(hello ~1) he)
assert!(slice!(12345 1~2) 23)

#sort! on text and numbers#
assert!(sort!hello ehllo)
assert!(sort!54321 12345)

#prepend! on text {first arg is a single char Thing}#
assert!(prepend!(W hello) Whello)

#concat! across text args returns text#
assert!(concat!(foo bar) foobar)
assert!(concat!(a b c) abc)

#find! / contains! search within text#
assert!(find!(hello l) 2)
assert!(contains!(hello e) TRUE)
assert!(contains!(hello z) FALSE)

#map! on text rebuilds text#
assert!(map!(abc upper.) ABC)

#filter! on text rebuilds text#
keepVowel:{c:_}(contains!((a e i o u) c.))
assert!(filter!(hello keepVowel.) eo)

#Lists still behave as lists, of course.#
assert!(slice!((1 2 3 4 5) 0~1) (1 2))
assert!(sort!(3 1 2) (1 2 3))
