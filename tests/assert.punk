#assert: self-checking tests, silent on pass#

#scalars#
assert![math.add![2 3] 5]
assert![math.sub![10 4] 6]
assert![logic.eq![1 1] TRUE]
assert![logic.eq![1 2] FALSE]

#lists#
assert![list.len![[a b c]] 3]
assert![list.find![[a b c] b] 1]
assert![list.concat![[1 2] [3 4]] [1 2 3 4]]
assert![list.range![0 5 1] [0 1 2 3 4]]

#nulls and booleans#
assert![NULL NULL]
assert![TRUE TRUE]
assert![list.find![[a b c] z] NULL]

#variadic#
assert![math.min![3 1 4 1 5 9 2 6] 1]
assert![math.max![3 1 4 1 5 9 2 6] 9]

#failure demo: uncomment the next line to see a formatted failure#
#assert![1 2]#
