#logic namespace — equality and comparisons#

#Numeric equality#
assert![eq![5 5] TRUE]
assert![eq![5 6] FALSE]

#Deep equality for lists#
assert![eq![[1 2 3] [1 2 3]] TRUE]
assert![eq![[1 2] [1 3]] FALSE]

#Numeric comparisons#
assert![gt![10 5] TRUE]
assert![gt![5 10] FALSE]
assert![lt![3 8] TRUE]
assert![lt![8 3] FALSE]

#Text comparisons (lexical)#
assert![gt![xyz abc] TRUE]
assert![lt![abc xyz] TRUE]

#Truthy semantics: NULL and FALSE are falsy, everything else is truthy#
assert![not!TRUE FALSE]
assert![not!FALSE TRUE]
assert![not!NULL TRUE]
assert![not!hello FALSE]
assert![not!0 FALSE]
assert![not![] FALSE]

#and: all truthy → TRUE, any falsy → FALSE#
assert![and![TRUE TRUE] TRUE]
assert![and![TRUE FALSE] FALSE]
assert![and![hello 1 [a]] TRUE]
assert![and![hello NULL 1] FALSE]
assert![and!hello TRUE]

#or: any truthy → TRUE, all falsy → FALSE#
assert![or![FALSE TRUE] TRUE]
assert![or![FALSE FALSE] FALSE]
assert![or![NULL FALSE hello] TRUE]
assert![or![NULL FALSE] FALSE]

#Variadic empty: identity values#
assert![and![] TRUE]
assert![or![] FALSE]
