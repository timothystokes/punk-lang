#Regex pattern slots in function signatures. Match against the formatted
 text of the input and bind the slot to (whole g1 g2 ...). Group 0 is the
 whole match (slot.0.); named groups are reachable via slot.<groupname>.
 No top-level bindings are introduced — the slot is the only one.#

#1. Bare regex slot in a single-arg signature: matches → bindings via groups#
greet:{m:"hello"}(
  m.0.
)
assert!(greet!hello hello)

#2. Direct call with no match → slot is NULL; lenient by design#
maybe:{m:"\d+"}(
  m.?(
    {NULL}(none)
    {_}(got\-it)
  )
)
assert!(maybe!nope none)
assert!(maybe!abc123 got-it)

#3. Capture groups are accessible by position via `name.<i>`#
parts:{m:"(\w+)-(\w+)"}(
  prepend!(m.1. prepend!(m.2. ()))
)
assert!(parts!John-Doe (John Doe))

#4. Named groups are reachable via `name.<groupname>`#
who:{m:"(?<first>\w+)-(?<last>\w+)"}(
  prepend!(m.first. prepend!(m.last. ()))
)
assert!(who!Ada-Lovelace (Ada Lovelace))

#5. Multiple regex slots: caller passes a list, one entry per slot.
 Regex captures are always text (strings), not Things-by-shape.#
both:{a:"\d+" b:"[a-z]+"}(
  prepend!(a.0. prepend!(b.0. ()))
)
r5:both!(42 hello)
assert!(len!r5. 2)
assert!(=!(r5.1. hello) TRUE)

#6. Direct call with one slot failing: that slot is NULL, others bind normally#
mixed:{a:"\d+" b:"[a-z]+"}(
  a.?(
    {NULL}(a\-missing)
    {_}(a\-ok)
  )
)
assert!(mixed!(abc hello) a-missing)
assert!(mixed!(42 hello) a-ok)

#7. `?` dispatch: a branch is SKIPPED when its regex doesn't match. So we
 can dispatch by shape across regexes, with a wildcard fallback.#
classify:{x:_}(
  x.?(
    {n:"^\d+$"}(number)
    {w:"^[a-z]+$"}(word)
    {_}(other)
  )
)
assert!(classify!123 number)
assert!(classify!hello word)
assert!(classify!Hello other)

#8. Named groups work in `?` branches: access via slot.<groupname>#
parseDate:{s:_}(
  s.?(
    {d:"^(?<y>\d{4})-(?<m>\d{2})-(?<dd>\d{2})$"}(
      (d.y. d.m. d.dd.)
    )
    {_}(invalid)
  )
)
d8:parseDate!2024-01-15
assert!(len!d8. 3)
assert!(parseDate!nope invalid)

#9. Regex matches against the formatted text of any value, including numbers#
isPositive:{m:"^\d+$"}(
  m.?(
    {NULL}(FALSE)
    {_}(TRUE)
  )
)
assert!(isPositive!42 TRUE)
assert!(isPositive!abc FALSE)

