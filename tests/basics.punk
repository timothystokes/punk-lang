#Basic Things, names, and literals — self-checked with `assert`#

#A name binds to its value; postfix `.` dereferences#
name:Charlie
assert!(name. Charlie)

#Numbers are Things#
assert!(42 42)

#TRUE / FALSE / NULL literals#
assert!(TRUE TRUE)
assert!(FALSE FALSE)
assert!(NULL NULL)

#Lists hold Things in order#
xs:(a b c)
assert!(xs. (a b c))

#Names are immutable: each function call gets its own scope, so a name
 used inside a function body is a fresh binding per call — not a rebind
 of any outer name. Shadowing across scopes is fine.#
double:{n:_}(d:*!(n. 2) d.)
assert!(double!5 10)
assert!(double!7 14)
