#Recursion: a function references its own bound name in its body#

#Non-tail recursion {stack used; small depth}#
fact:{n:_}(
  n.?(
    {0}(1)
    {_}(*!(n. fact!-!(n. 1)))
  )
)
assert!(fact!0 1)
assert!(fact!1 1)
assert!(fact!5 120)
assert!(fact!10 3628800)

#List recursion via index / slice / prep {Lisp spine}#
sum:{lst:_}(
  len!lst.?(
    {0}(0)
    {_}(+!(lst.0. sum!(lst.1~.)))
  )
)
assert!(sum!(()) 0)
assert!(sum!((7)) 7)
assert!(sum!((1 2 3 4 5)) 15)

#Tail-call optimisation: a self-call in the last position of a body
 {or the chosen branch of `?`} trampolines, so deep recursion
 doesn't blow the JS stack.#
countdown:{n:_}(
  n.?(
    {0}(done)
    {_}(countdown!-!(n. 1))
  )
)
assert!(countdown!10000 done)

#Tail call through nested `?` arms still trampolines#
walk:{n:_}(
  n.?(
    {0}(walked)
    {_}(walk!-!(n. 1))
  )
)
assert!(walk!5000 walked)

