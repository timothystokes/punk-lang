#Function definition and application#
#A function body is a sequence of expressions; the call's value is the
 value of the LAST expression in the body {Clojure-style}. Earlier
 expressions run for their side effects and any name bindings they make.#

#Single-param function — parameter is named with `name:_`#
identity:{x:_}(x.)
assert!(identity!hello hello)

#Multi-param function — each parameter is named#
plus:{a:_ b:_}(+!(a. b.))
assert!(plus!(5 3) 8)

#Three-param function returning the last#
last3:{a:_ b:_ c:_}(c.)
assert!(last3!(a b c) c)

#Earlier expressions still run; only the LAST value is returned#
seq:{x:_}(
  y:+!(x. 1)
  *!(y. 10)
)
assert!(seq!4 50)

#Variadic with `___` — name binds the whole match#
all:{xs:___}(xs.)
assert!(all!(a b c) (a b c))

#Anonymous variadic — `_.` derefs the whole argument as passed#
allUnnamed:{___}(_.)
assert!(allUnnamed!(a b c) (a b c))

#`_.` is available in every function, even with positional named params#
pairAll:{a:_ b:_}(_.)
assert!(pairAll!(1 2) (1 2))

#A trailing `___` slot is anonymous; `_.` still gives the full argument#
trailing:{x:_ ___}(_.)
assert!(trailing!(1 2 3 4) (1 2 3 4))

#Un-named single-slot patterns. `_.` is the raw arg as passed.#
processOne:{_}(_.)
assert!(processOne!hello hello)

processTwo:{_ _}(+!(_.0. _.1.))
assert!(processTwo!(3 4) 7)

processN:{___}(len!_.)
assert!(processN!(a b c) 3)

processAandN:{a:_ ___}(+!(a. len!_.))
assert!(processAandN!(10 b c) 13)

#Function reference — `name.` is the value of the function#
double:{n:_}(*!(n. 2))
ref:double.
assert!(ref!21 42)

#Higher-order: map applies the function to each element#
assert!(map!(double. (1 2 3)) (2 4 6))

#reduce! with a builtin passed by name: +. is the add function value#
assert!(reduce!(+. 0 (1 2 3 4 5)) 15)
assert!(reduce!(*. 1 (2 3 4)) 24)

#filter! with a builtin predicate#
assert!(filter!({n:_}(<!(n. 3)) (1 2 3 4)) (1 2))
