#Range literals: `N~M` produces an inclusive list of integers#
assert!(1~5 (1 2 3 4 5))
assert!(0~0 (0))
#Reversed range yields the empty list#
assert!(5~1 ())
#Negative bounds are fine#
assert!(-2~2 (-2 -1 0 1 2))

#Range literals work inside other lists#
assert!((0~3 a b) ((0 1 2 3) a b))

#Ranges compose with list builtins#
assert!(len!1~10 10)
assert!(map!(1~3 {n:_}(*!(n. n.))) (1 4 9))
sum:{xs:_}(len!xs.?({0}(0) {_}(+!(xs.0. sum!(xs.1~.)))))
assert!(sum!(1~10) 55)
assert!(sum!(1~100) 5050)

#A range expression is interchangeable with a literal list at the call site#
assert!(sum!(1~4) 10)

#Postfix-dot of a range materialises and indexes#
r:1~5
assert!(r.0. 1)
assert!(r.~. 5)
big:1~10
assert!(big.2~4. (3 4 5))

#Range value as an arg to slice! {inclusive both ends}#
assert!(slice!((a b c d e) 1~3) (b c d))
assert!(slice!((a b c d e) 2~) (c d e))
assert!(slice!((a b c d e) ~2) (a b c))

#len! of a Range materialises#
assert!(len!1~5 5)
