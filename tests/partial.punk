#Partial application with `'`. Mirrors `!` but returns a pre-bound value
 instead of invoking. Later `!` extends the captured args and invokes.#

addTen:+'10
assert!(addTen!5 15)
assert!(addTen!90 100)

#args-list form pre-binds multiple positions#
add3:{a:_ b:_ c:_}(+!(a. +!(b. c.)))
add12:add3'(1 2)
assert!(add12!10 13)

#partial of partial: rebind through name#
addOne:add3'1
twoPlus:addOne'2
assert!(twoPlus!7 10)

#partial preserves zero-args identity: applying with no extension invokes as-is#
addFive:+'(2 3)
assert!(addFive! 5)

#partial of higher-order list ops (function-first order)#
inc:{n:_}(+!(n. 1))
incAll:map'inc.
assert!(incAll!(1 2 3) (2 3 4))

sum:reduce'(+. 0)
assert!(sum!(1 2 3 4 5) 15)
